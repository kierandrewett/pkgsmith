[3.988926, "o", "\u001b[1;1H\u001b[93m  1 \u001b[m\u001b[96m# One manifest, four distros. Each matrix entry names its own image and setup.\u001b[m\r\n\u001b[93m  2 \u001b[m\u001b[96m# Entries on the same image (deb and tar) share one build.\u001b[m\r\n\u001b[93m  3 \u001b[m\u001b[1m\u001b[96mname\u001b[m\u001b[38;5;224m:\u001b[m hello\r\n\u001b[93m  4 \u001b[m\u001b[1m\u001b[96mversion\u001b[m\u001b[38;5;224m:\u001b[m 1.0.0\r\n\u001b[93m  5 \u001b[m\u001b[1m\u001b[96mdescription\u001b[m\u001b[38;5;224m:\u001b[m A demo that packages a small C program\r\n\u001b[93m  6 \u001b[m\u001b[1m\u001b[96mmaintainer\u001b[m\u001b[38;5;224m:\u001b[m Kieran Drewett <kieran@drewett.dev>\r\n\u001b[93m  7 \u001b[m\u001b[1m\u001b[96mlicense\u001b[m\u001b[38;5;224m:\u001b[m MIT\r\n\u001b[93m  8 \r\n  9 \u001b[m\u001b[96m# The build is the same everywhere. pkgsmith records the files it installs and packages them.\u001b[m\r\n\u001b[93m 10 \u001b[m\u001b[1m\u001b[96mbuild\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;224m|\u001b[m\r\n\u001b[93m 11 \u001b[m  make\r\n\u001b[93m 12 \u001b[m  make install PREFIX=/usr\r\n\u001b[93m 13 \r\n 14 \u001b[m\u001b[1m\u001b[96mmatrix\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m 15 \u001b[m  \u001b[1m\u001b[96minclude\u001b[m\u001b[38;5;224m:\u001b[m\r\n\u001b[93m 16 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mformat\u001b[m\u001b[38;5;224m:\u001b[m rpm\r\n\u001b[93m 17 \u001b[m      \u001b[1m\u001b[96mdistro\u001b[m\u001b[38;5;224m:\u001b[m fedora\r\n\u001b[93m 18 \u001b[m      \u001b[1m\u001b[96mimage\u001b[m\u001b[38;5;224m:\u001b[m fedora:43\r\n\u001b[93m 19 \u001b[m      \u001b[1m\u001b[96msetup\u001b[m\u001b[38;5;224m:\u001b[m dnf -y install gcc make\r\n\u001b[93m 20 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mformat\u001b[m\u001b[38;5;224m:\u001b[m deb\r\n\u001b[93m 21 \u001b[m      \u001b[1m\u001b[96mdistro\u001b[m\u001b[38;5;224m:\u001b[m debian\r\n\u001b[93m 22 \u001b[m      \u001b[1m\u001b[96mimage\u001b[m\u001b[38;5;224m:\u001b[m debian:13\r\n\u001b[93m 23 \u001b[m      \u001b[1m\u001b[96msetup\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;121m&apt\u001b[m \u001b[38;5;224m|\u001b[m\r\n\u001b[93m 24 \u001b[m\u001b[8Capt-get update -qq\r\n\u001b[93m 25 \u001b[m\u001b[8CDEBIAN_FRONTEND=noninteractive apt-get install -y gcc make\r\n\u001b[93m 26 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mformat\u001b[m\u001b[38;5;224m:\u001b[m tar\r\n\u001b[93m 27 \u001b[m      \u001b[1m\u001b[96mdistro\u001b[m\u001b[38;5;224m:\u001b[m debian\r\n\u001b[93m 28 \u001b[m      \u001b[1m\u001b[96mimage\u001b[m\u001b[38;5;224m:\u001b[m debian:13\r\n\u001b[93m 29 \u001b[m      \u001b[1m\u001b[96msetup\u001b[m\u001b[38;5;224m:\u001b[m \u001b[38;5;121m*apt\u001b[m\r\n\u001b[93m 30 \u001b[m    \u001b[93m-\u001b[m \u001b[1m\u001b[96mformat\u001b[m\u001b[38;5;224m:\u001b[m archlinux\r\n\u001b[93m 31 \u001b[m      \u001b[1m\u001b[96mdistro\u001b[m\u001b[38;5;224m:\u001b[m arch\r\n\u001b[93m 32 \u001b[m      \u001b[1m\u001b[96mimage\u001b[m\u001b[38;5;224m:\u001b[m archlinux:base\r\n\u001b[1m\u001b[7mpkgsmith.yaml                                                                     1,1            Top\u001b[?25h\u001b[1;5H\u001b[?4m"]
