[4.621, "o", "\u001b[?1049h\u001b[22;0;0t\u001b[>4;2m\u001b[?1h\u001b=\u001b[?2004h\u001b[?1004h\u001b[1;34r\u001b[?12h\u001b[?12l\u001b[22;2t\u001b[22;1t\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[?25l\u001b[34;1H\"pkgsmith.yaml\" 28L, 944B\u001b[2;1H\u25bd\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[>c\u001b]11;?\u0007\u001b[1;1H# One manifest, four distros. Each distro is a lane. Lanes build side by side, and formats that sharr\u001b[2;1He a build\u001b[2;10H\u001b[K\u001b[3;1H# (deb and tar here) run it once.\u001b[3;34H\u001b[K\u001b[4;1Hname: hello\r\nversion: 1.0.0\r\ndescription: A tracked-build demo\r\nmaintainer: Kieran Drewett <kieran@drewett.dev>\r\nlicense: MIT\r\n\r\nmatrix:\r\n  include:\r\n    - { distro: fedora, image: \"fedora:43\", format: rpm }\r\n    - { distro: debian, image: \"debian:13\", format: deb }\r\n    - { distro: debian, image: \"debian:13\", format: tar }\r\n    - { distro: arch, image: \"archlinux:base\", format: archlinux }\r\n    - { distro: alpine, image: \"alpine:3.22\", format: apk }\r\n\r\nimage: ${{ matrix.image }}\r\nsetup: |\r\n  . /etc/os-release\r\n  case \"$ID\" in\r\n    fedora) dnf -y install gcc make ;;\r\n    debian) apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y gcc make ;;\r\n    arch)   pacman -Sy --noconfirm gcc make ;;\r\n    alpine) apk add --no-cache gcc make musl-dev ;;\r\n  esac\r\nbuild: |\r\n  make\r\n  make install PREFIX=/usr\r\n\u001b[94m~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[33;1H~                                                                                                   \u001b[m\u001b[34;83H1,1\u001b[11CAll\u001b[?25h\u001b[1;1H\u001b[?25l\u001b[34;73H^D\u001b[1;1H\u001b[34;73H  \u001b[17;1H\u001b[34;84H6,0-1\u001b[17;1H\u001b[?25h\u001b[?4m"]
