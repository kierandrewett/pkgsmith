[3.748588, "o", "\u001b[14t\u001b[16t"]
[3.749407, "o", "\u001b[1;1H\u001b[93m  1 \u001b[m# The script of the demo. First install the program into a prefix, then build the packages from  \u001b[2;1H\u001b[93m    \u001b[mit:\r\n\u001b[93m  2 \u001b[m#\r\n\u001b[93m  3 \u001b[m#   make install DESTDIR=prefix\r\n\u001b[93m  4 \u001b[m#   pkgsmith build\r\n\u001b[93m  5 \u001b[m#\r\n\u001b[93m  6 \u001b[m# pkgsmith does not build the program. The Makefile does, and `make install` puts hello and its  \u001b[8;1H\u001b[93m    \u001b[mfiles in ./prefix. This\r\n\u001b[93m  7 \u001b[m# script describes the packages made from that folder, in every format, and pkgsmith writes themm\u001b[10;1H\u001b[93m    \u001b[m to ./dist.\r\n\u001b[93m  8 \r\n  9 \u001b[mcommon = {\r\n\u001b[93m 10 \u001b[m    \"name\": \"hello\",\r\n\u001b[93m 11 \u001b[m    \"version\": \"1.0.0\",\r\n\u001b[93m 12 \u001b[m    \"description\": \"A demo that packages a small C program\",\r\n\u001b[93m 13 \u001b[m    \"maintainer\": \"Kieran Drewett <kieran@drewett.dev>\",\r\n\u001b[93m 14 \u001b[m    \"license\": \"MIT\",\r\n\u001b[93m 15 \u001b[m    # The Makefile installs this file. The package manager keeps the changes that the user made  \u001b[19;1H\u001b[93m    \u001b[mto it.\r\n\u001b[93m 16 \u001b[m    \"config_files\": [\"/etc/hello.conf\"],\r\n\u001b[93m 17 \u001b[m}\r\n\u001b[93m 18 \r\n 19 \u001b[mfor format in [\"rpm\", \"deb\", \"archlinux\", \"apk\", \"tar\"]:\r\n\u001b[93m 20 \u001b[m    package(format, **common)\r\n\u001b[94m~                                                                                                   \u001b[26;1H~                                                                                                   \u001b[27;1H~                                                                                                   \u001b[28;1H~                                                                                                   \u001b[29;1H~                                                                                                   \u001b[30;1H~                                                                                                   \u001b[31;1H~                                                                                                   \u001b[32;1H~                                                                                                   \u001b[m\u001b[33;1H\u001b[1m\u001b[7mpkgsmith.star                                                                     1,1            All\u001b[?25h\u001b[1;5H\u001b[?4m"]
